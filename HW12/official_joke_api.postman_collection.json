  "item": [
    {
      "name": "jokes/random",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('response fields must be correct', function(){\r",
              "    const json = pm.response.json();\r",
              "\r",
              "    pm.expect(json.id).to.exist;\r",
              "    pm.expect(json.type).to.exist;\r",
              "    pm.expect(json.setup).to.exist;\r",
              "    pm.expect(json.punchline).to.exist;\r",
              "});\r",
              "\r",
              "pm.test('response fields must be with correct type', function(){\r",
              "    const json = pm.response.json();\r",
              "\r",
              "    pm.expect(json.id).to.be.a('number');\r",
              "    pm.expect(json.type).to.be.a('string').and.not.empty;\r",
              "    pm.expect(json.setup).to.be.a('string').and.not.empty;\r",
              "    pm.expect(json.punchline).to.be.a('string').and.not.empty;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}jokes/random",
          "host": [
            "{{base_url}}jokes"
          ],
          "path": [
            "random"
          ]
        }
      },
      "response": []
    },
